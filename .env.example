# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=

# Email address that receives contact form submissions and newsletter signups
CONTACT_RECEIVER=

# Verified domain sender for visitor freebie delivery (e.g. Mohamed Dhia <hello@dhia-portfolio.com>)
DELIVERY_FROM=

# Anthropic (Claude) — powers the site chatbot (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5

NEXT_PUBLIC_SITE_URL=https://dhia-portfolio.com
